{
  "name": "quickpizza-performance-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Controlled black-box performance tests for the public QuickPizza demo.",
  "main": "target/bundle",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "dependencies": {
    "@gatling.io/core": "3.15.105",
    "@gatling.io/http": "3.15.105"
  },
  "devDependencies": {
    "@gatling.io/cli": "3.15.105",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "typescript": "7.0.2"
  },
  "scripts": {
    "clean": "rimraf target",
    "format": "prettier --write \"**/*.{ts,mjs,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,mjs,json,md,yml}\"",
    "safety:check": "node scripts/verify-safety.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && gatling build --typescript",
    "quality": "npm run format:check && npm run safety:check && npm run build",
    "smoke": "npm run typecheck && gatling run --typescript --simulation quickPizza profile=smoke",
    "package:enterprise": "npm run typecheck && gatling enterprise-package",
    "deploy:enterprise": "npm run typecheck && gatling enterprise-deploy --non-interactive"
  }
}
