{
  "name": "quickpizza-performance-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Controlled black-box performance tests for the public QuickPizza demo.",
  "main": "target/bundle",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "dependencies": {
    "@gatling.io/core": "3.15.105",
    "@gatling.io/http": "3.15.105"
  },
  "devDependencies": {
    "@gatling.io/cli": "3.15.105",
    "@types/node": "24.19.0",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "scripts": {
    "clean": "rimraf target",
    "format": "prettier --write \"**/*.{ts,mts,json,md,yml}\" \"!artifacts/**\"",
    "format:check": "prettier --check \"**/*.{ts,mts,json,md,yml}\" \"!artifacts/**\"",
    "safety:check": "node scripts/verify-safety.mts",
    "test": "node --test tests/*.test.mts",
    "results:compare": "node scripts/compare-results.mts",
    "typecheck": "tsc --noEmit && npm run typecheck:tooling",
    "typecheck:tooling": "tsc -p tsconfig.tooling.json",
    "build": "npm run typecheck && gatling build --typescript",
    "quality": "npm run format:check && npm run safety:check && npm test && npm run build",
    "smoke": "npm run typecheck && gatling run --typescript --simulation quickPizza profile=smoke",
    "package:enterprise": "npm run typecheck && gatling enterprise-package",
    "deploy:enterprise": "npm run typecheck && gatling enterprise-deploy --non-interactive"
  }
}
